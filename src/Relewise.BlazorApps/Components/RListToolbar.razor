@using MudBlazor

<div class="list-toolbar @(Actions is null ? null : "has-actions")">
    <RTextField Label="Search" Placeholder="SearchPlaceholder" Value="@Search" ValueChanged="SearchChanged"
                Immediate="true" DebounceInterval="300" Clearable="true" FullWidth="true" />
    <RButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.FilterList" OnClick="ToggleFilters"
             AriaLabel="Toggle filters">@(ShowFilters ? "Hide filters" : "Filters")</RButton>
    <RButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Refresh" Disabled="Loading" OnClick="Refresh">Refresh</RButton>
    @Actions
</div>

@code {
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public string? SearchPlaceholder { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public bool ShowFilters { get; set; }
    [Parameter] public EventCallback ToggleFilters { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
