<RIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@ToolTip" OnClick="OnClick" Disabled="Disabled" ToolTip="@ToolTip" Size="Size"/>

@code {

    [Parameter] [EditorRequired] public required EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string ToolTip { get; set; } = "Refresh";

    [Parameter] public Size Size { get; set; } = Size.Small;

}