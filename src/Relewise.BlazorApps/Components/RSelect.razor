@typeparam T
@* ReSharper disable CSharpWarnings::CS8619 *@
@* ReSharper disable CSharpWarnings::CS8620 *@
<MudSelect Dense="true"
           T="T"
           Value="@Value"
           Label="@Label"
           Variant="@Variant"
           Margin="@Margin"
           Disabled="@Disabled"
           UserAttributes="@(AriaLabel is null ? new Dictionary<string, object>() : new Dictionary<string, object> { ["aria-label"] = AriaLabel })"
           ValueChanged="@ValueChanged"
           ToStringFunc="GetDisplayText"
           Clearable="@Clearable"
           Required="@Required"
           Class="@Class"
           Style="@Style">
    @* ReSharper restore CSharpWarnings::CS8620 *@
    @* ReSharper restore CSharpWarnings::CS8619 *@
    @if (Items.Any())
    {
        foreach (T item in Items)
        {
            <MudSelectItem T="T" Value="item">
                @GetDisplayText(item)
            </MudSelectItem>
        }
    }
</MudSelect>

@code {

    [Parameter] public required Func<T, string>? ToStringFunc { get; set; }

    [Parameter] [EditorRequired] public required IEnumerable<T> Items { get; set; }

    [Parameter] public T? Value { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback<T> ValueChanged { get; set; }

    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter] public Margin Margin { get; set; } = Margin.Dense;

    [Parameter] public string? Style { get; set; }

    [Parameter] public bool Clearable { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private string? GetDisplayText(T? item)
    {
        if (item is null)
        {
            return string.Empty;
        }

        if (ToStringFunc != null)
        {
            return ToStringFunc(item);
        }

        return item.ToString();
    }

}
