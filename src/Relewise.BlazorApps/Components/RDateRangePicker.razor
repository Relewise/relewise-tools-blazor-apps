
@* ReSharper disable CSharpWarnings::CS8619 *@
@* ReSharper disable CSharpWarnings::CS8620 *@
@if (PickerActions != null)
{
    <MudDateRangePicker @ref="_element"
                        DateRange="@DateRange"
                        DateRangeChanged="@DateRangeChanged"
                        Label="@Label"
                        Variant="@Variant"
                        Margin="@Margin"
                        Class="@Class"
                        Disabled="@Disabled"
                        Style="@Style"
                        PlaceholderStart="@PlaceholderStart"
                        PlaceholderEnd="@PlaceholderEnd"
                        PickerVariant="@PickerVariant"
                        FirstDayOfWeek="@FirstDayOfWeek"
                        ShowWeekNumbers="@ShowWeekNumbers"
                        ReadOnly="@ReadOnly"
                        Clearable="@Clearable"
                        Required="@Required"
                        DateFormat="@(DateFormatString ?? DateFormat.GetFormat() ?? DefaultDateFormat)"
                        @attributes="@AdditionalAttributes">
        <PickerActions>
            @PickerActions
        </PickerActions>
    </MudDateRangePicker>
}
else
{
    <MudDateRangePicker @ref="_element"
                        DateRange="@DateRange"
                        DateRangeChanged="@DateRangeChanged"
                        Label="@Label"
                        Variant="@Variant"
                        Margin="@Margin"
                        Class="@Class"
                        Disabled="@Disabled"
                        Style="@Style"
                        PlaceholderStart="@PlaceholderStart"
                        PlaceholderEnd="@PlaceholderEnd"
                        PickerVariant="@PickerVariant"
                        FirstDayOfWeek="@FirstDayOfWeek"
                        ShowWeekNumbers="@ShowWeekNumbers"
                        ReadOnly="@ReadOnly"
                        Clearable="@Clearable"
                        Required="@Required"
                        DateFormat="@(DateFormatString ?? DateFormat.GetFormat() ?? DefaultDateFormat)"
                        @attributes="@AdditionalAttributes" />
}

@code {
    private const string DefaultDateFormat = "dd. MMM yyyy";
    private MudDateRangePicker? _element;

    [Parameter] public DateRange? DateRange { get; set; }

    [Parameter] public EventCallback<DateRange> DateRangeChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? PlaceholderStart { get; set; }

    [Parameter] public string? PlaceholderEnd { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    [Parameter] public bool Clearable { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter] public Margin Margin { get; set; } = Margin.Dense;

    [Parameter] public PickerVariant PickerVariant { get; set; } = PickerVariant.Inline;

    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }

    [Parameter] public bool ShowWeekNumbers { get; set; }

    [Parameter] public DateFormat? DateFormat { get; set; } = global::Relewise.BlazorApps.Components.DateFormat.Date;

    [Parameter] public string? DateFormatString { get; set; }

    [Parameter] public RenderFragment? PickerActions { get; set; }

    [Parameter] public Dictionary<string, object>? AdditionalAttributes { get; set; }


    public async Task FocusStartAsync()
    {
        if (_element != null)
        {
            await _element.FocusStartAsync();
        }
    }


    public async Task CloseAsync()
    {
        if (_element != null)
        {
            await _element.CloseAsync();
        }
    }
}
