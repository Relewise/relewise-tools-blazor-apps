@using MudBlazor
@using Relewise.BlazorApps.Components
@using Relewise.BlazorApps.TypeEditors
@using Relewise.BlazorApps.Shared.ColumnPresenter
@using global::Relewise.Client.Requests.Filters
@using global::Relewise.Client.Requests.Conditions
@page "/Products"
@implements IDisposable
@inject ISnackbar Snackbar

<PageTitle>Blazor Relewise - Products</PageTitle>
<h1>Products</h1>
<p>Find products, edit their properties and variants, or enable and disable them.</p>

@if ((StaticDatasetStorage.ParentOrigin is null || string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey)) && !(SavedConnectionStorage.Enabled && SavedConnectionStorage.HasSavedConfiguration))
{
    <ConnectionCredentials>
        <PermissionsNote>You can't use your Master key in this application so you will have to create some separate key that can use the <code>DataAccessor</code> and the <code>Tracker</code> to use this.</PermissionsNote>
    </ConnectionCredentials>
}

@if (dataAccessor is null || tracker is null || connecting)
{
    <RButton Disabled="connecting" OnClick="ConnectAsync">@(connecting ? "Connecting…" : "Connect")</RButton>
}
else
{
    <MudStack Spacing="2">
        <RListToolbar Search="searchText" SearchChanged="SearchChanged" ShowFilters="showFilters"
                      ToggleFilters="ToggleFilters" Refresh="RefreshProducts" Loading="loadingProducts"
                      SearchPlaceholder="Name contains or exact product / variant ID" />
        @if (showFilters)
        {
            <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                <div class="product-filters">
                    <RTextField Label="Exact product ID" @bind-Value="productIdFilter" Clearable="true" FullWidth="true" />
                    <RTextField Label="Display name contains" @bind-Value="displayNameFilter" Clearable="true" FullWidth="true" />
                    <RTextField Label="Name language" @bind-Value="displayNameLanguage" FullWidth="true" />
                    <RSelect T="string" Label="Status" Items="statusOptions" @bind-Value="statusFilter" />
                    <MudStack Row="true" Spacing="1">
                        <RButton OnClick="ApplyFilters" Disabled="loadingProducts">Apply filters</RButton>
                        <RButton Variant="Variant.Text" OnClick="ClearFilters" Disabled="loadingProducts">Clear</RButton>
                    </MudStack>
                </div>
            </MudPaper>
        }
        <MudDataGrid T="ProductAndVariantEditContext" @ref="productGrid" ServerData="LoadProducts"
                     RowsPerPage="50" Dense="true" Striped="true" Hover="true" Bordered="false" Elevation="0"
                     SortMode="SortMode.None" Filterable="false" ReadOnly="true">
            <Columns>
                <PropertyColumn Property="item => item.Product.Id" Title="Product ID">
                    <CellTemplate Context="row">
                        <div class="d-flex align-center justify-space-between" style="width: 100%; gap: 8px;">
                            <span>@row.Item.Product.Id</span>
                            <span class="flex-shrink-0"><RCopyButton Text="@row.Item.Product.Id" ToolTip="Copy product ID" /></span>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.DisplayNameText" Title="Display name">
                    <CellTemplate Context="row">
                        <MultilingualColumnPresenter Value="row.Item.Product.DisplayName" ShowCopyButton="true" />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.Status" Title="Status">
                    <CellTemplate Context="row">
                        <MudChip T="string" Size="Size.Small" Color="@(row.Item.ProductIsDisabled ? Color.Default : Color.Success)">
                            @(row.Item.ProductIsDisabled ? "Disabled" : "Enabled")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Variants" Filterable="false">
                    <CellTemplate Context="row">@(row.Item.ProductVariants?.Count ?? 0)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" CellClass="product-actions" Filterable="false">
                    <CellTemplate Context="row">
                        <MudStack Row="true" Spacing="1">
                            @if (row.Item.ProductIsDisabled)
                            {
                                <RIconButton Icon="@Icons.Material.Filled.CheckCircleOutline" ToolTip="Enable product"
                                             aria-label="Enable product" OnClick="() => EnableProduct(row.Item)" />
                            }
                            else
                            {
                                <RIconButton Icon="@Icons.Material.Filled.Block" ToolTip="Disable product"
                                             aria-label="Disable product" OnClick="() => DisableProduct(row.Item)" />
                            }
                            @if (row.Item.IsBeingEdited)
                            {
                                <RButton Variant="Variant.Text" OnClick="() => DiscardChanges(row.Item)">Discard</RButton>
                                <RButton OnClick="() => Update(row.Item)">Save changes</RButton>
                            }
                            else
                            {
                                <RIconButton Icon="@Icons.Material.Filled.Edit" ToolTip="Edit product"
                                             aria-label="Edit product" OnClick="() => StartEdit(row.Item)" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowRenderer Context="row">
                @if (row.Item.IsBeingEdited)
                {
                    <tr class="mud-table-row">
                        <td class="mud-table-cell" colspan="5">
                            <CascadingValue Value="row.Item.Validation">
                            <MudStack Class="pa-4" Spacing="2">
                        <RCheckBox Label="Expand all" @bind-Value="openDetails" />
                        <ObjectEditor OpenDetails="openDetails" SingleLevelOpenDetails="true" T="Product" Value="row.Item.Product"
                                      Setter="(object? value) => { row.Item.Product = (Product)value!; StateHasChanged(); }" />
                        @if (row.Item.ProductVariants is not null && row.Item.ProductVariantsDisabled is not null)
                        {
                            <MudText Typo="Typo.h6">Variants</MudText>
                            @for (int index = 0; index < row.Item.ProductVariants.Count; index++)
                            {
                                int variantIndex = index;
                                <div class="variant-editor">
                                    <RButton Variant="Variant.Outlined" OnClick="() => ToggleVariant(row.Item, variantIndex)">
                                        @(row.Item.ProductVariantsDisabled[variantIndex] ? "Enable" : "Disable")
                                    </RButton>
                                    <ObjectEditor OpenDetails="openDetails" T="ProductVariant" Value="row.Item.ProductVariants[variantIndex]"
                                                  Setter="(object? value) => { row.Item.ProductVariants[variantIndex] = (ProductVariant)value!; row.Item.VariantsHadChanges = true; StateHasChanged(); }" />
                                </div>
                            }
                        }
                            </MudStack>
                            </CascadingValue>
                        </td>
                    </tr>
                }
            </ChildRowRenderer>
            <NoRecordsContent>
                <MudText>No products match your search and filters.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="ProductAndVariantEditContext" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudStack>
}

@code {
    private bool openDetails;
    private DataAccessor? dataAccessor;
    private Tracker? tracker;
    private List<ProductAndVariantEditContext>? productsInView;

    protected override async Task OnInitializedAsync()
    {
        if (StaticDatasetStorage.DatasetId is not "" && !string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey))
        {
            if (StaticDatasetStorage.ParentOrigin is null)
                await ConnectAsync();
            else
                Connect();
        }
        StaticDatasetStorage.AuthenticationReceived += Authenticated;
    }

    private void Authenticated(object? sender, EventArgs args)
    {
        Connect();
        StateHasChanged();
    }

    private bool connecting;

    [Inject]
    public required IJSRuntime ConnectionRuntime { get; set; }

    private async Task ConnectAsync()
    {
        if (connecting) return;
        connecting = true;
        try
        {
            if (!Connect()) return;
            using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            await dataAccessor!.QueryAsync(new ProductQuery("__connection_check__"), cancellation.Token);
            await SavedConnectionStorage.SaveAsync(ConnectionRuntime);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connection failed. Check the server URL, dataset ID, API key, and its permissions. " + ex.GetBaseException().Message, Severity.Error);
            dataAccessor = null;
            tracker = null;
        }
        finally
        {
            connecting = false;
        }
    }

    private bool Connect()
    {
        try
        {
            dataAccessor = new DataAccessor(new Guid(StaticDatasetStorage.DatasetId), StaticDatasetStorage.ApiKey, StaticDatasetStorage.ServerUrl);
            tracker = new Tracker(new Guid(StaticDatasetStorage.DatasetId), StaticDatasetStorage.ApiKey, StaticDatasetStorage.ServerUrl);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            return false;
        }
    }

    private MudDataGrid<ProductAndVariantEditContext>? productGrid;
    private bool loadingProducts;
    private string searchText = "";
    private (int Page, int PageSize, string Search, string ProductId, string DisplayName, string Language, string Status)? loadedPageKey;
    private int loadedTotal;
    private bool showFilters;
    private string productIdFilter = "";
    private string displayNameFilter = "";
    private string displayNameLanguage = "";
    private string statusFilter = "All";
    private string appliedProductId = "";
    private string appliedDisplayName = "";
    private string appliedDisplayNameLanguage = "";
    private string appliedStatus = "All";
    private readonly string[] statusOptions = ["All", "Enabled", "Disabled"];

    private async Task SearchChanged(string value)
    {
        searchText = value?.Trim() ?? "";
        loadedPageKey = null;
        if (productGrid is null) return;
        if (productGrid.CurrentPage == 0)
            await productGrid.ReloadServerData();
        else
            productGrid.NavigateTo(MudBlazor.Page.First);
    }

    private void ToggleFilters() => showFilters = !showFilters;

    private async Task ApplyFilters()
    {
        appliedProductId = productIdFilter?.Trim() ?? "";
        appliedDisplayName = displayNameFilter?.Trim() ?? "";
        appliedDisplayNameLanguage = displayNameLanguage?.Trim() ?? "";
        appliedStatus = statusFilter ?? "All";
        loadedPageKey = null;
        if (productGrid is null) return;
        if (productGrid.CurrentPage == 0)
            await productGrid.ReloadServerData();
        else
            productGrid.NavigateTo(MudBlazor.Page.First);
    }

    private async Task ClearFilters()
    {
        productIdFilter = "";
        displayNameFilter = "";
        statusFilter = "All";
        await ApplyFilters();
    }

    private async Task RefreshProducts()
    {
        loadedPageKey = null;
        if (productGrid is not null)
            await productGrid.ReloadServerData();
    }

    private GridData<ProductAndVariantEditContext> LoadedPage() => new()
    {
        Items = productsInView?.ToArray() ?? [],
        TotalItems = loadedTotal
    };

    private FilterCollection ProductFilters()
    {
        List<Filter> filters = [];
        if (!string.IsNullOrWhiteSpace(searchText))
            filters.Add(new OrFilter([
                new ProductIdFilter(searchText),
                new VariantIdFilter(searchText),
                new ProductDisplayNameFilter(new ContainsCondition(new DataValue(searchText)), Language.Undefined)
            ]));
        if (!string.IsNullOrWhiteSpace(appliedProductId))
            filters.Add(new ProductIdFilter(appliedProductId));
        if (!string.IsNullOrWhiteSpace(appliedDisplayName))
            filters.Add(new ProductDisplayNameFilter(new ContainsCondition(new DataValue(appliedDisplayName)),
                string.IsNullOrWhiteSpace(appliedDisplayNameLanguage) ? Language.Undefined : new Language(appliedDisplayNameLanguage)));
        if (appliedStatus != "All")
            filters.Add(new ProductDisabledFilter(negated: appliedStatus == "Enabled"));
        return new FilterCollection(filters.ToArray());
    }

    private async Task<GridData<ProductAndVariantEditContext>> LoadProducts(GridState<ProductAndVariantEditContext> state, CancellationToken cancellationToken)
    {
        var pageKey = (state.Page, state.PageSize, searchText, appliedProductId, appliedDisplayName, appliedDisplayNameLanguage, appliedStatus);
        if (loadedPageKey == pageKey && productsInView is not null) return LoadedPage();
        loadingProducts = true;
        try
        {
            var result = await dataAccessor!.QueryAsync(new ProductQuery
            {
                Filters = ProductFilters(),
                NumberOfResults = state.PageSize,
                SkipNumberOfResults = state.Page * state.PageSize,
                ReturnTotalNumberOfResults = true,
                IncludeDisabledProducts = true,
                IncludeDisabledVariants = true
            }, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (string.IsNullOrWhiteSpace(displayNameLanguage))
                displayNameLanguage = result.Products
                    .SelectMany(product => product.DisplayName?.Values ?? [])
                    .Select(value => value.Language?.Value)
                    .FirstOrDefault(language => !string.IsNullOrWhiteSpace(language)) ?? "";
            productsInView = new();
            foreach (var productResult in result.Products)
            {
                ProductAndVariantEditContext context = new(new Product(productResult.ProductId)
                    {
                        DisplayName = productResult.DisplayName,
                        Assortments = productResult.Assortments?.ToList(),
                        CategoryPaths = productResult.CategoryPaths?.Select(cp => new CategoryPath() { BreadcrumbPathStartingFromRoot = cp.BreadcrumbPathStartingFromRoot })?.ToList(),
                        Data = productResult.Data,
                        Custom = productResult.Custom,
                        Brand = productResult.Brand is null ? null : new Brand(productResult.Brand.BrandId)
                        {
                            DisplayName = productResult.Brand.DisplayName,
                            Assortments = productResult.Brand.Assortments?.ToList(),
                            Data = productResult.Brand.Data
                        },
                        ListPrice = productResult.ListPrice,
                        SalesPrice = productResult.SalesPrice
                    },
                    productResult.Disabled);

                if (productResult.AllVariants?.Length > 0)
                {
                    context.ProductVariants = new(productResult.AllVariants.Length);
                    context.ProductVariantsDisabled = new(productResult.AllVariants.Length);

                    foreach (VariantResultDetails productVariantResult in productResult.AllVariants)
                    {
                        context.ProductVariantsDisabled.Add(productVariantResult.Disabled);
                        context.ProductVariants.Add(new ProductVariant(productVariantResult.VariantId)
                            {
                                DisplayName = productVariantResult.DisplayName,
                                Assortments = productVariantResult.Assortments?.ToList(),
                                Specification = productVariantResult.Specification,
                                Data = productVariantResult.Data,
                                Custom = productVariantResult.Custom,
                                ListPrice = productVariantResult.ListPrice,
                                SalesPrice = productVariantResult.SalesPrice
                            });
                    }
                }
                context.VariantsHadChanges = false;
                productsInView.Add(context);
            }
            Snackbar.Add($"Loaded {productsInView.Count} products.", Severity.Success);
            loadedPageKey = pageKey;
            loadedTotal = result.TotalNumberOfResults ?? productsInView.Count;
            return LoadedPage();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return new GridData<ProductAndVariantEditContext> { Items = [], TotalItems = 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            return new GridData<ProductAndVariantEditContext> { Items = [], TotalItems = 0 };
        }
        finally
        {
            loadingProducts = false;
        }
    }

    private async Task StartEdit(ProductAndVariantEditContext context)
    {
        context.IsBeingEdited = true;
        await Task.CompletedTask;
    }

    private Task ToggleVariant(ProductAndVariantEditContext context, int index) => context.ProductVariantsDisabled![index]
        ? EnableVariant(context, index)
        : DisableVariant(context, index);

    private async Task Update(ProductAndVariantEditContext context)
    {
        if (!context.Validation.IsValid)
        {
            Snackbar.Add(string.Join(" ", context.Validation.Errors), Severity.Error);
            return;
        }
        try
        {
            if (context.VariantsHadChanges)
            {
                await tracker!.TrackAsync(
                    new ProductUpdate(
                        context.Product,
                        context.ProductVariants,
                        ProductUpdate.UpdateKind.ReplaceProvidedProperties,
                        ProductUpdate.UpdateKind.ReplaceProvidedProperties,
                        replaceExistingVariants: true)
                );
            }
            else
            {
                await tracker!.TrackAsync(new ProductUpdate(context.Product, ProductUpdate.UpdateKind.ReplaceProvidedProperties));
            }
            Snackbar.Add("Successfully updated the product" + (context.VariantsHadChanges ? " and variants." : "."), Severity.Success);
            context.IsBeingEdited = false;
            context.VariantsHadChanges = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    public async Task DiscardChanges(ProductAndVariantEditContext context)
    {
        context.IsBeingEdited = false;
    }

    private async Task EnableProduct(ProductAndVariantEditContext context)
    {
        if (!Connect()) return;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await tracker!.TrackAsync(
                new ProductAdministrativeAction(null, null, context.Product.Id, ProductAdministrativeAction.UpdateKind.Enable)
            );
            context.ProductIsDisabled = false;
            Snackbar.Add("Successfully enabled the product.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    private async Task DisableProduct(ProductAndVariantEditContext context)
    {
        if (!Connect()) return;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await tracker!.TrackAsync(
                new ProductAdministrativeAction(null, null, context.Product.Id, ProductAdministrativeAction.UpdateKind.Disable)
            );
            context.ProductIsDisabled = true;
            Snackbar.Add("Successfully disabled the product.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    private async Task EnableVariant(ProductAndVariantEditContext context, int variantIndex)
    {
        if (!Connect() || context.ProductVariants is null || context.ProductVariantsDisabled is null) return;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await tracker!.TrackAsync(
                new ProductAdministrativeAction(null, null, context.Product.Id, ProductAdministrativeAction.UpdateKind.None, context.ProductVariants[variantIndex].Id, ProductAdministrativeAction.UpdateKind.Enable)
            );
            context.ProductVariantsDisabled[variantIndex] = false;
            Snackbar.Add("Successfully enabled the variant.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    private async Task DisableVariant(ProductAndVariantEditContext context, int variantIndex)
    {
        if (!Connect() || context.ProductVariants is null || context.ProductVariantsDisabled is null) return;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await tracker!.TrackAsync(
                new ProductAdministrativeAction(null, null, context.Product.Id, ProductAdministrativeAction.UpdateKind.None, context.ProductVariants[variantIndex].Id, ProductAdministrativeAction.UpdateKind.Disable)
            );
            context.ProductVariantsDisabled[variantIndex] = true;
            Snackbar.Add("Successfully disabled the variant.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        StaticDatasetStorage.AuthenticationReceived -= Authenticated;
    }

    public class ProductAndVariantEditContext(Product product, bool productIsDisabled)
    {
        public EditorValidationState Validation { get; } = new();
        public Product Product { get; set; } = product;
        public string DisplayNameText => string.Join(" / ", Product.DisplayName?.Values?.Select(value => value.Text) ?? []);
        public string Status => ProductIsDisabled ? "Disabled" : "Enabled";
        public bool ProductIsDisabled { get; set; } = productIsDisabled;
        public List<ProductVariant>? ProductVariants { get; set; } = null;
        public List<bool>? ProductVariantsDisabled { get; set; } = null;
        public bool IsBeingEdited { get; set; } = false;
        public bool VariantsHadChanges { get; set; } = false;
    }
}
