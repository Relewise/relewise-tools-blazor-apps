@using MudBlazor
@using Relewise.BlazorApps.Components
@using Relewise.BlazorApps.Shared
@using System.Reflection
@inject ISnackbar Snackbar
@inject NugetClient NugetClient
@inject NavigationManager NavigationManager
@inject ILogger<Versions> Logger
@page "/Versions"

<PageTitle>Blazor Relewise - Versions</PageTitle>

<h1>Versions</h1>
<MudText Class="mb-4" Color="Color.Secondary">Compare Relewise SDK releases to see added types, enum values, and property changes.</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@errorMessage</MudAlert>
    <RButton OnClick="Retry" Icon="@Icons.Material.Filled.Refresh">Retry</RButton>
    @if (comparisonFailed)
    {
        <RButton Variant="Variant.Outlined" Class="ml-2" OnClick="Reset">Select versions</RButton>
    }
    return;
}
@if (loadingVersions)
{
    <MudStack Spacing="2" Class="py-4">
        <MudText>Loading SDK versions…</MudText>
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    </MudStack>
    return;
}
@if (versions.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">No SDK versions are currently available.</MudAlert>
    <RButton OnClick="LoadVersions" Icon="@Icons.Material.Filled.Refresh">Retry</RButton>
    return;
}

@if (selectingVersions)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
        <div class="version-selectors">
            <MudAutocomplete T="string" Label="From version" @bind-Value="LeftVersion" SearchFunc="FindVersions"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                             HelperText="@PublishedOn(LeftVersion)" MaxItems="50" ResetValueOnEmptyText="true" Strict="false">
                <ItemTemplate Context="version">
                    <div class="version-option"><span>@version</span><span>@PublishedOn(version)</span></div>
                </ItemTemplate>
            </MudAutocomplete>
            <MudAutocomplete T="string" Label="To version" @bind-Value="RightVersion" SearchFunc="FindVersions"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                             HelperText="@PublishedOn(RightVersion)" MaxItems="50" ResetValueOnEmptyText="true" Strict="false">
                <ItemTemplate Context="version">
                    <div class="version-option"><span>@version</span><span>@PublishedOn(version)</span></div>
                </ItemTemplate>
            </MudAutocomplete>
            <RButton OnClick="Compare" Disabled="@(!ReadyToCompare)" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.CompareArrows" Size="Size.Medium" Class="version-compare-button">Compare selected versions</RButton>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
        <div class="comparison-heading">
            <div class="comparison-versions">
                <div><MudText Typo="Typo.overline">From</MudText><MudText Typo="Typo.h6">@LeftVersion</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@PublishedOn(LeftVersion)</MudText></div>
                <RIcon Icon="@Icons.Material.Filled.ArrowForward" />
                <div><MudText Typo="Typo.overline">To</MudText><MudText Typo="Typo.h6">@RightVersion</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@PublishedOn(RightVersion)</MudText></div>
            </div>
            <RButton Variant="Variant.Outlined" OnClick="Reset" Disabled="comparing">Select versions</RButton>
        </div>
    </MudPaper>
    @if (comparing)
    {
        <MudStack Spacing="2" Class="py-4">
            <MudText>@comparisonStatus</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        <MudText Class="mb-3" Color="Color.Secondary">@TotalChanges @(TotalChanges == 1 ? "change" : "changes") found. Expand a section to explore the details.</MudText>
        <MudExpansionPanels MultiExpansion="true" Dense="true" Elevation="0" Outlined="true">
            <VersionChangesPanel Title="Added types" Rows="AddedTypeRows" />
            <VersionChangesPanel Title="Added enum types" Rows="AddedEnumRows" />
            <VersionChangesPanel Title="Added enum values" Rows="EnumValueRows" ShowMember="true" MemberTitle="Added value" />
            <VersionChangesPanel Title="Added properties" Rows="AddedPropertyRows" ShowMember="true" ShowCurrent="true" />
            <VersionChangesPanel Title="Changed property types" Rows="ChangedPropertyRows" ShowMember="true" ShowPrevious="true" ShowCurrent="true" CurrentTitle="New type" />
        </MudExpansionPanels>
    }
}

@code {
    private List<NugetClient.PackageVersion> versions = new();
    private bool selectingVersions = true;
    private bool loadingVersions = true;
    private string? errorMessage;
    private bool comparisonFailed;
    private bool comparing;
    private string comparisonStatus = "Preparing comparison…";

    public bool ReadyToCompare => versions.Any(version => version.Version == LeftVersion)
        && versions.Any(version => version.Version == RightVersion);

    private NugetClient.PackageVersion[] LatestReleases => versions.Where(version => !version.Version.Contains('-'))
        .OrderByDescending(version => version.Published).Take(2).ToArray();

    private Task<IEnumerable<string>> FindVersions(string text, CancellationToken cancellationToken)
        => Task.FromResult(versions.Where(version => string.IsNullOrWhiteSpace(text)
            || version.Version.Contains(text, StringComparison.OrdinalIgnoreCase)).Select(version => version.Version));

    private string PublishedOn(string? version) => versions.FirstOrDefault(item => item.Version == version) is { } match
        ? $"Published {match.Published:d MMM yyyy}" : "";

    private IReadOnlyList<VersionChangeRow> AddedTypeRows => addedTypes?.Select(type => new VersionChangeRow(Settings.Name(type))).ToArray() ?? [];
    private IReadOnlyList<VersionChangeRow> AddedEnumRows => addedEnums?.Select(type => new VersionChangeRow(Settings.Name(type))).ToArray() ?? [];
    private IReadOnlyList<VersionChangeRow> EnumValueRows => changedEnums?.SelectMany(item => item.Item2.Select(value => new VersionChangeRow(Settings.Name(item.Item1), value))).ToArray() ?? [];
    private IReadOnlyList<VersionChangeRow> AddedPropertyRows => addedProperties?.SelectMany(item => item.PropertiesAdded.Select(property => new VersionChangeRow(Settings.Name(item.Type), property.Name, Current: Settings.PropertyTypeName(property)))).ToArray() ?? [];
    private IReadOnlyList<VersionChangeRow> ChangedPropertyRows => changedProperties?.SelectMany(item => item.PropertiesChanged.Select(property => new VersionChangeRow(Settings.Name(item.Type), property.Name, property.OldType, property.NewType))).ToArray() ?? [];
    private int TotalChanges => (addedTypes?.Count ?? 0) + (addedEnums?.Count ?? 0)
        + (changedEnums?.Sum(item => item.Item2.Count) ?? 0) + (addedProperties?.Sum(item => item.PropertiesAdded.Count) ?? 0)
        + (changedProperties?.Sum(item => item.PropertiesChanged.Count) ?? 0);

    List<Type>? addedEnums;
    List<(Type, List<string>)>? changedEnums;
    List<Type>? addedTypes;
    List<(Type Type, List<(string Name, string OldType, string NewType)> PropertiesChanged)>? changedProperties;
    List<(Type Type, List<PropertyInfo> PropertiesAdded)>? addedProperties;


    [SupplyParameterFromQuery(Name = "from")]
    public string? LeftVersion { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? RightVersion { get; set; }

    [SupplyParameterFromQuery(Name = "compareToPreviousVersion")]
    public string? CompareToPreviousVersion { get; set; }

    protected override Task OnInitializedAsync() => LoadVersions();

    private async Task LoadVersions()
    {
        errorMessage = null;
        comparisonFailed = false;
        loadingVersions = true;
        try
        {
            await InitializeVersions();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load SDK versions from the Relewise CDN.");
            errorMessage = "Could not load SDK versions from the Relewise CDN. Check your connection and try again.";
            Snackbar.Add(errorMessage + " " + exception.GetBaseException().Message, Severity.Error);
        }
        finally
        {
            loadingVersions = false;
        }
    }

    private Task Retry() => comparisonFailed ? Compare() : LoadVersions();

    private async Task InitializeVersions()
    {
        versions = await NugetClient.Versions("Relewise.Client");

        if (!versions.Any(v => v.Version == LeftVersion))
            LeftVersion = null;

        if (!versions.Any(v => v.Version == RightVersion))
            RightVersion = null;

        bool compareFromLink = LeftVersion is not null && RightVersion is not null;

        if (versions.Count > 0
            && versions.FirstOrDefault(v => v.Version == CompareToPreviousVersion) is { } comparingVersion
            && versions.Last() != comparingVersion)
        {
            LeftVersion = versions[versions.IndexOf(comparingVersion) + 1].Version;
            RightVersion = comparingVersion.Version;
            compareFromLink = true;
        }

        var latest = LatestReleases;
        if (latest.Length > 0) RightVersion ??= latest[0].Version;
        if (latest.Length > 1) LeftVersion ??= latest[1].Version;
        loadingVersions = false;
        if (compareFromLink)
            await Compare();
    }

    private void Reset()
    {
        errorMessage = null;
        comparisonFailed = false;
        selectingVersions = true;
        addedEnums = null;
        changedEnums = null;
        addedTypes = null;
        addedProperties = null;
        changedProperties = null;
    }

    private async Task Compare()
    {
        errorMessage = null;
        comparisonFailed = false;
        comparing = true;
        try
        {
            await CompareVersions();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to compare SDK versions {FromVersion} and {ToVersion}.", LeftVersion, RightVersion);
            Reset();
            comparisonFailed = true;
            errorMessage = "Could not compare the selected SDK versions. Check your connection and try again.";
            Snackbar.Add(errorMessage + " " + exception.GetBaseException().Message, Severity.Error);
        }
        finally
        {
            comparing = false;
        }
    }

    private async Task CompareVersions()
    {
        selectingVersions = false;
        StateHasChanged();
        // Switch to right order if the left was not the smallest.
        if (versions.IndexOf(versions.Single(v => v.Version == RightVersion)) > versions.IndexOf(versions.Single(v => v.Version == LeftVersion)))
        {
            (LeftVersion, RightVersion) = (RightVersion, LeftVersion);
        }

        string url = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>()
        {
            { "from", LeftVersion },
            { "to", RightVersion },
            { "compareToPreviousVersion", null }
        });
        NavigationManager.NavigateTo(url, replace: true);

        comparisonStatus = $"Downloading SDK {LeftVersion}…";
        StateHasChanged();
        var oldestDLL = await NugetClient.DLL("Relewise.Client", LeftVersion!);
        comparisonStatus = $"Downloading SDK {RightVersion}…";
        StateHasChanged();
        var newestDLL = await NugetClient.DLL("Relewise.Client", RightVersion!);
        comparisonStatus = "Comparing SDK assemblies…";
        StateHasChanged();

        var oldestAssembly = Assembly.Load(oldestDLL);
        var newestAssembly = Assembly.Load(newestDLL);

        var oldConcreteTypes = Models.GetTypes(oldestAssembly.GetTypes());
        var newConcreteTypes = Models.GetTypes(newestAssembly.GetTypes());

        var oldEnumTypes = Models.GetEnumTypes(oldestAssembly.GetTypes());
        var newEnumTypes = Models.GetEnumTypes(newestAssembly.GetTypes());

        addedEnums = new();
        changedEnums = new();

        foreach (var newType in newEnumTypes)
        {
            if (oldEnumTypes.FirstOrDefault(oldType => oldType.FullName == newType.FullName) is { } matchingOldType)
            {
                List<string> oldValues = new();
                foreach (var value in Enum.GetValues(matchingOldType))
                {
                    oldValues.Add(value.ToString());
                }
                List<string> newValues = new();
                foreach (var value in Enum.GetValues(newType))
                {
                    newValues.Add(value.ToString());
                }

                List<string> addedEnumValues = newValues.Where(newValue => !oldValues.Contains(newValue)).ToList();

                if (addedEnumValues.Count > 0)
                {
                    changedEnums.Add((newType, addedEnumValues));
                    StateHasChanged();
                    await Task.Delay(1);
                }
            }
            else
            {
                addedEnums.Add(newType);
                StateHasChanged();
                await Task.Delay(1);
            }
        }

        addedTypes = new();
        addedProperties = new();
        changedProperties = new();

        foreach (var newType in newConcreteTypes)
        {
            if (oldConcreteTypes.FirstOrDefault(oldType => oldType.FullName == newType.FullName) is { } matchingOldType)
            {
                var oldProperties = Settings.GetProperties(matchingOldType);
                var newProperties = Settings.GetProperties(newType);

                List<PropertyInfo> newlyAddedProperties = newProperties
                    .Where(p => !oldProperties.Any(old => old.Name == p.Name))
                    .ToList();

                if (newlyAddedProperties.Count > 0)
                {
                    addedProperties.Add((newType, newlyAddedProperties));
                    StateHasChanged();
                    await Task.Delay(1);
                }

                List<PropertyInfo> newlyTypedProperties = newProperties
                    .Where(p => oldProperties.Any(old => old.Name == p.Name && Settings.PropertyTypeName(old) != Settings.PropertyTypeName(p)))
                    .ToList();

                if (newlyTypedProperties.Count > 0)
                {
                    changedProperties.Add((newType, newlyTypedProperties.Select(p => (p.Name, Settings.PropertyTypeName(oldProperties.Single(o => o.Name == p.Name)), Settings.PropertyTypeName(p))).ToList()));
                    StateHasChanged();
                    await Task.Delay(1);
                }
            }
            else
            {
                addedTypes.Add(newType);
                StateHasChanged();
                await Task.Delay(1);
            }

        }
    }
}
