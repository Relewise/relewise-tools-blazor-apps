@using MudBlazor
@inject ISnackbar Snackbar
@using Relewise.BlazorApps.Components
@page "/Recommendations"
@using Relewise.BlazorApps.TypeEditors
@using Relewise.BlazorApps.Extensions
@using System.Reflection
@using Newtonsoft.Json
@using Newtonsoft.Json.Converters
@using global::Relewise.Client.Requests
@using global::Relewise.Client.Requests.Recommendations
@using global::Relewise.Client.Responses
@using Relewise.Client.Requests.Recommendations.Feed
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Blazor Relewise - Recommendations</PageTitle>

<h1>Recommendations</h1>

@if ((StaticDatasetStorage.ParentOrigin is null || string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey)) && !(SavedConnectionStorage.Enabled && SavedConnectionStorage.HasSavedConfiguration))
{
    <ConnectionCredentials>
        <PermissionsNote>You can't use your Master key in this application so you will have to create some separate key that can use the <code>Recommender</code>.</PermissionsNote>
    </ConnectionCredentials>
}

@if (recommender is null || connecting)
{
    <div class="mb-2">
    <RButton Disabled="connecting" OnClick="ConnectAsync">@(connecting ? "Connecting…" : "Connect")</RButton>
    </div>
}

<div class="mb-2">
    <RTextField Label="Search" @bind-Value="SearchTerm" @bind-Value:after="Search"
                Immediate="true" DebounceInterval="250" Clearable="true" FullWidth="true" />
</div>
<div class="recommendation-workspace @(navigationOpen ? null : "navigation-collapsed")" @ref="workspaceElement">
    <MudPaper Outlined="true" Elevation="0" Class="recommendation-navigation">
        <div class="content-navigation-toolbar">
            <RIconButton Icon="@(navigationOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)"
                         ToolTip="@(navigationOpen ? "Collapse content sidebar" : "Expand content sidebar")"
                         aria-label="@(navigationOpen ? "Collapse content sidebar" : "Expand content sidebar")"
                         aria-expanded="@(navigationOpen ? "true" : "false")" aria-controls="content-navigation-menu"
                         OnClick="() => navigationOpen = !navigationOpen" />
        </div>
        <div id="content-navigation-menu" class="content-navigation-menu" hidden="@(!navigationOpen)">
        <RequestNavigation AdvancedRequestType="typeof(SimilarProductsRequest)" Groups="groupings" Selected="SelectedRecommendation" Name="RecommendationName"
                                  OnSelected="selection => SelectRecommendation(selection.Group, selection.Request)" />
        </div>
    </MudPaper>
    <MudPaper Outlined="true" Elevation="0" Class="recommendation-content pa-4">
        @if (SelectedRecommendation is { } recommendation)
        {
            GetEditorState(recommendation);
            @foreach (var entry in editorStates)
            {
                Type requestType = entry.Key;
                bool isSelected = requestType == recommendation;
                <div style="@(isSelected ? null : "display: none;")" aria-hidden="@(isSelected ? "false" : "true")">
                    <RecommendationConstructor @key="requestType" RequestType="requestType"
                                               RequestTitle="@RecommendationName(requestType)" RequestFactory="() => GetRequest(requestType)"
                                               Request="initValues.GetValueOrDefault(requestType)" State="entry.Value" IsActive="isSelected"
                                               OpenDetails="true" ShowHeader="false" Connect="Connect"
                                               Recommender="@(connecting ? null : recommender)" />
                </div>
            }
        }
        else
        {
            <MudText>No recommendation types match your search.</MudText>
        }
    </MudPaper>
</div>

@code {
    private bool navigationOpen = true;
    private ElementReference workspaceElement;
    private IJSObjectReference? layoutModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender) return;
            layoutModule = await ConnectionRuntime.InvokeAsync<IJSObjectReference>("import", "./js/recommendationLayout.js");
            await layoutModule.InvokeVoidAsync("initialize", workspaceElement);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (layoutModule is null) return;
        await layoutModule.InvokeVoidAsync("dispose", workspaceElement);
        await layoutModule.DisposeAsync();
    }
    private Recommender? recommender;
    private Dictionary<string, List<Type>> groupings = new();
    private readonly Dictionary<Type, LicensedRequest> initValues = new();
    private int activeTabIndex;
    private readonly Dictionary<string, int> requestTabIndices = new();
    private readonly Dictionary<Type, RecommendationConstructor.EditorState> editorStates = new();

    private RecommendationConstructor.EditorState GetEditorState(Type type)
    {
        if (!editorStates.TryGetValue(type, out var state))
            editorStates[type] = state = new();
        return state;
    }

    private Type? SelectedRecommendation => groupings.Count == 0 ? null
        : groupings.ElementAt(activeTabIndex).Value.ElementAtOrDefault(GetRequestTabIndex(groupings.ElementAt(activeTabIndex).Key));

    private void SelectRecommendation(string group, Type recommendation)
    {
        activeTabIndex = groupings.Keys.ToList().IndexOf(group);
        requestTabIndices[group] = groupings[group].IndexOf(recommendation);
    }

    private int GetRequestTabIndex(string group) => Math.Clamp(requestTabIndices.GetValueOrDefault(group), 0, Math.Max(0, groupings[group].Count - 1));

    private static string RecommendationName(Type type)
    {
        string name = type.SpaceSeparatedName();
        return name.EndsWith("Request", StringComparison.Ordinal) ? name[..^8] : name;
    }
    private string? loadedCompressedObject;

    private LicensedRequest GetRequest(Type type)
    {
        if (!initValues.TryGetValue(type, out var request))
        {
            request = (LicensedRequest)Activator.CreateInstance(type)!;
            initValues[type] = request;
        }
        return request;
    }

    [SupplyParameterFromQuery(Name = "q")]
    public string SearchTerm { get; set; } = "";

    [SupplyParameterFromQuery(Name = "o")]
    public string? CompressedObject { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (StaticDatasetStorage.DatasetId is not "" && !string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey))
        {
            if (StaticDatasetStorage.ParentOrigin is null)
                await ConnectAsync();
            else
                Connect();
        }
        StaticDatasetStorage.AuthenticationReceived += Authenticated;
    }

    private void Authenticated(object? sender, EventArgs args)
    {
        Connect();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (SearchTerm is null)
            {
                SearchTerm = "";
            }

            await Search();

            if (CompressedObject is not null && CompressedObject != loadedCompressedObject)
            {
                String decompressedString = await Models.FromGzipAsync(CompressedObject.Replace(" ", "+"));
                var jsonSerializerSettings = new JsonSerializerSettings
                    {
                        TypeNameHandling = TypeNameHandling.Auto,
                        NullValueHandling = NullValueHandling.Ignore,
                        Formatting = Formatting.None,
                        Converters = [new StringEnumConverter()]
                    };
                LicensedRequest decompressedObject = JsonConvert.DeserializeObject<LicensedRequest>(decompressedString, jsonSerializerSettings)!;
                if (allRecommendationTypes.FirstOrDefault(t => t == decompressedObject?.GetType()) is { } matchingType)
                {
                    initValues[matchingType] = decompressedObject;
                    var state = GetEditorState(matchingType);
                    state.Request = decompressedObject;
                    state.RequestInitialized = true;
                    state.Response = null;
                    activeTabIndex = groupings.Keys.ToList().FindIndex(key =>
                        key == "Uncategorized" ? uncategorizedTypes.Contains(matchingType) : RecommendationGroupings[key].Contains(matchingType));
                    if (activeTabIndex >= 0)
                    {
                        var group = groupings.ElementAt(activeTabIndex);
                        requestTabIndices[group.Key] = Math.Max(0, group.Value.IndexOf(matchingType));
                    }
                    loadedCompressedObject = CompressedObject;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
    }

    private bool connecting;

    [Inject]
    public required IJSRuntime ConnectionRuntime { get; set; }

    private async Task ConnectAsync()
    {
        if (connecting) return;
        connecting = true;
        try
        {
            if (!Connect()) return;
            using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            await recommender!.RecommendAsync(new PopularProductsRequest(null, null, "Connection check", User.Anonymous(), global::Relewise.Client.Requests.Shared.PopularityTypes.MostViewed, 60) { Settings = new() { NumberOfRecommendations = 1 } }, cancellation.Token);
            await SavedConnectionStorage.SaveAsync(ConnectionRuntime);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connection failed. Check the server URL, dataset ID, API key, and its permissions. " + ex.GetBaseException().Message, Severity.Error);
            recommender = null;
        }
        finally
        {
            connecting = false;
        }
    }

    private bool Connect()
    {
        try
        {
            recommender = new Recommender(new Guid(StaticDatasetStorage.DatasetId), StaticDatasetStorage.ApiKey, StaticDatasetStorage.ServerUrl);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            return false;
        }
    }

    public static Dictionary<string, List<Type>> RecommendationGroupings = new()
        {
            ["Product"] = [typeof(PopularProductsRequest),
            typeof(PersonalProductRecommendationRequest),
            typeof(PurchasedWithProductRequest),
            typeof(PurchasedWithCurrentCartRequest),
            typeof(PurchasedWithMultipleProductsRequest),
            typeof(ProductsViewedAfterViewingProductRequest),
            typeof(ProductsViewedAfterViewingContentRequest),
            typeof(RecentlyViewedProductsRequest),
            typeof(SearchTermBasedProductRecommendationRequest),
            typeof(SimilarProductsRequest),
            typeof(SortProductsRequest),
            typeof(SortVariantsRequest),
            typeof(CustomProductRecommendationRequest)],

            ["Content"] = [typeof(PopularContentsRequest),
            typeof(PersonalContentRecommendationRequest),
            typeof(ContentsViewedAfterViewingContentRequest),
            typeof(ContentsViewedAfterViewingProductRequest),
            typeof(ContentsViewedAfterViewingMultipleContentsRequest),
            typeof(ContentsViewedAfterViewingMultipleProductsRequest)],

            ["Brand"] = [typeof(PopularBrandsRecommendationRequest),
            typeof(PersonalBrandRecommendationRequest)],

            ["Product Category"] = [typeof(PopularProductCategoriesRecommendationRequest),
            typeof(PersonalProductCategoryRecommendationRequest)],

            ["Content Category"] = [typeof(PopularContentCategoriesRecommendationRequest),
            typeof(PersonalContentCategoryRecommendationRequest)],

            ["Search Term"] = [typeof(PopularSearchTermsRecommendationRequest)],

            ["Batched"] = [typeof(ProductRecommendationRequestCollection),
            typeof(ContentRecommendationRequestCollection)],

            ["Feed"] = [typeof(FeedRecommendationInitializationRequest),
				typeof(FeedRecommendationNextItemsRequest)]
        };

    private static List<Type> allRecommendationTypes =
        Assembly
            .GetAssembly(typeof(ClientBase))!
            .GetExportedTypes()
            .Where(type =>
                type != typeof(RecommendationRequest)
                && (type.IsAssignableTo(typeof(RecommendationRequest)) || type == typeof(FeedRecommendationNextItemsRequest))
                && type is { IsGenericType: false, IsAbstract: false })
            .Append(typeof(ProductRecommendationRequestCollection))
            .Append(typeof(ContentRecommendationRequestCollection))
            .ToList();

    private static List<Type> uncategorizedTypes =
        allRecommendationTypes
            .Where(t => !RecommendationGroupings.SelectMany(m => m.Value).Contains(t))
            .ToList();

    private Task Search()
    {
        groupings = RecommendationGroupings.ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value
                .Where(ContainsSearch)
                .ToList()
        );

        if (uncategorizedTypes.Count > 0)
            groupings["Uncategorized"] = uncategorizedTypes.Where(ContainsSearch).ToList();

        if (activeTabIndex >= groupings.Count || groupings.ElementAt(activeTabIndex).Value.Count == 0)
        {
            int firstMatch = groupings.Values.ToList().FindIndex(types => types.Count > 0);
            activeTabIndex = Math.Max(0, firstMatch);
        }

        return Task.CompletedTask;
    }

    private Dictionary<Type, string> typeNames = new();

    private bool ContainsSearch(Type type)
    {
        if(!typeNames.TryGetValue(type, out string? typeName))
        {
            typeName = type.Name;
            typeNames[type] = typeName;
        }
        return typeName.Contains(SearchTerm.Replace(" ", ""), StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        StaticDatasetStorage.AuthenticationReceived -= Authenticated;
    }
}
