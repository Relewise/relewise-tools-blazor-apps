@using MudBlazor
@inject ISnackbar Snackbar
@using Relewise.BlazorApps.Components
@using Relewise.BlazorApps.TypeEditors
@using System.Reflection
@using System.Threading
@using global::Relewise.Client.DataTypes.Triggers.Configurations
@using global::Relewise.Client.Requests
@using global::Relewise.Client.Responses
@using global::Relewise.Client.Responses.Triggers
@page "/Triggers"
@implements IDisposable

<PageTitle>Blazor Relewise - Triggers</PageTitle>

<h1>Triggers</h1>
<p>Here you can create and edit Trigger Configurations.</p>
@if ((StaticDatasetStorage.ParentOrigin is null || string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey)) && !(SavedConnectionStorage.Enabled && SavedConnectionStorage.HasSavedConfiguration))
{
    <ConnectionCredentials>
        <PermissionsNote>You can't use your Master key in this application so you will have to create some separate key that has access to edit Triggers to use this.</PermissionsNote>
    </ConnectionCredentials>
}

@if (triggerAccessor is null || connecting)
{
    <RButton Disabled="connecting" OnClick="ConnectAsync">@(connecting ? "Connecting…" : "Connect")</RButton>
    <br />
}
else
{
    <MudStack Row="true" Spacing="2" Class="mb-4">
        <RButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Refresh" Disabled="loadingConfigurations"
                 OnClick="RefreshConfigurations">Refresh</RButton>
        <RButton Icon="@Icons.Material.Filled.Add" Disabled="loadingConfigurations" OnClick="CreateNewConfiguration">Create New Configuration</RButton>
    </MudStack>
}
@if (selectedConfiguration is not null || creatingNew)
{
    <ObjectEditor OpenDetails=true ShowModelShareLink=true T=TriggerConfiguration Value="selectedConfiguration" Setter="(Object? obj) => { selectedConfiguration = (TriggerConfiguration?)obj; StateHasChanged(); }" />
    <br />
    <label for="name">Your name: </label>
    <input @bind=name id="name" />
    <br />
    <br />
    @if (creatingNew)
    {
        <button class="btn btn-success" disabled=@(selectedConfiguration is null || string.IsNullOrEmpty(name)) @onclick=Create>Create</button>
        @if (selectedConfiguration is null || string.IsNullOrEmpty(name))
        {
            <i>You need to create a specific configuration and set the name before you can create the configuration.</i>
        }
    }
    else
    {
        <button class="btn btn-success" disabled=@string.IsNullOrEmpty(name) @onclick=Update>Update</button>
        @if (string.IsNullOrEmpty(name))
        {
            <i>You need to set the name before you have update the configuration.</i>
        }
    }
}
else if (configurations is not null || loadingConfigurations)
{
    <MudDataGrid T="TriggerListItem" Items="triggerRows" QuickFilter="MatchesSearch" @ref="triggerGrid"
                 RowsPerPage="25" Dense="true" Striped="true" Hover="true" Bordered="false" Elevation="0"
                 SortMode="SortMode.Multiple" Filterable="false"
                 ReadOnly="true" Loading="loadingConfigurations">
        <ToolBarContent>
            <RTextField Label="Search" Value="@searchText" ValueChanged="SearchChanged"
                        Immediate="true" DebounceInterval="300" Clearable="true" FullWidth="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="item => item.Name" Title="Name">
                <CellTemplate Context="row">
                    <div class="d-flex align-center justify-space-between" style="width: 100%; gap: 8px;">
                        <span>@row.Item.Name</span>
                        <span class="flex-shrink-0"><RCopyButton Text="@row.Item.Name" ToolTip="Copy trigger name" /></span>
                    </div>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="item => item.TypeName" Title="Type" />
            <PropertyColumn Property="item => item.Group" Title="Group" />
            <PropertyColumn Property="item => item.Description" Title="Description" />
            <TemplateColumn Title="Actions" Filterable="false" Sortable="false">
                <CellTemplate Context="row">
                    <RIconButton Icon="@Icons.Material.Filled.Edit" ToolTip="Edit trigger configuration"
                                 aria-label="Edit trigger configuration" OnClick="() => Edit(row.Item.Configuration)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText>No triggers match your search.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="TriggerListItem" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudDataGrid>
}
@code {
    private bool loadingConfigurations;
    private string searchText = "";
    private MudDataGrid<TriggerListItem>? triggerGrid;
    private TriggerListItem[] triggerRows = [];

    public sealed record TriggerListItem(TriggerConfiguration Configuration)
    {
        public string Name => Configuration.Name ?? "";
        public string TypeName => Configuration.GetType().Name;
        public string Group => Configuration.Group ?? "";
        public string Description => Configuration.Description ?? "";
    }

    private bool MatchesSearch(TriggerListItem item)
    {
        string term = searchText.Trim();
        return term.Length == 0
            || item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.TypeName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Group.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Description.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private void SearchChanged(string value)
    {
        searchText = value ?? "";
        triggerGrid?.NavigateTo(MudBlazor.Page.First);
    }
    private string name = "";
    private bool creatingNew = false;
    private object? triggerAccessor;
    private TriggerConfiguration[]? configurations;
    private TriggerConfiguration? selectedConfiguration;

    protected override async Task OnInitializedAsync()
    {
        StaticDatasetStorage.AuthenticationReceived += Authenticated;
        if (StaticDatasetStorage.DatasetId is not "" && !string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey))
        {
            if (StaticDatasetStorage.ParentOrigin is null)
                await ConnectAsync();
            else
                await RefreshConfigurations();
        }
    }

    private void Authenticated(object? sender, EventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshConfigurations();
            StateHasChanged();
        });
    }

    private bool connecting;

    [Inject]
    public required IJSRuntime ConnectionRuntime { get; set; }

    private async Task ConnectAsync()
    {
        if (connecting) return;
        connecting = true;
        try
        {
            if (!Connect()) return;
            using var cancellation = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var loadMethod = triggerAccessorType.GetMethods().First(m => m.Name == "LoadAsync" && m.ReturnType == typeof(Task<TriggerConfigurationCollectionResponse>));
            var response = await (Task<TriggerConfigurationCollectionResponse>)loadMethod.Invoke(triggerAccessor, [cancellation.Token])!;
            ApplyConfigurations(response);
            await SavedConnectionStorage.SaveAsync(ConnectionRuntime);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connection failed. Check the server URL, dataset ID, API key, and its permissions. " + ex.GetBaseException().Message, Severity.Error);
            triggerAccessor = null;
        }
        finally
        {
            connecting = false;
        }
    }

    private bool Connect()
    {
        try
        {
            triggerAccessor = triggerAccessorType
                .GetConstructors(BindingFlags.NonPublic | BindingFlags.Instance)
                .Single(c => c.GetParameters() is { Length: 4 } p && p[3].ParameterType == typeof(TimeSpan))
                .Invoke([new Guid(StaticDatasetStorage.DatasetId), StaticDatasetStorage.ApiKey, StaticDatasetStorage.ServerUrl, TimeSpan.FromSeconds(30)]);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            return false;
        }
    }

    private async Task RefreshConfigurations()
    {
        if (loadingConfigurations || !Connect()) return;
        loadingConfigurations = true;
        try
        {
            var loadMethod = triggerAccessorType.GetMethods().First(m => m.Name == "LoadAsync" && m.ReturnType == typeof(Task<TriggerConfigurationCollectionResponse>));
            Task<TriggerConfigurationCollectionResponse> responseTask = (Task<TriggerConfigurationCollectionResponse>)loadMethod.Invoke(triggerAccessor, [CancellationToken.None])!;
            TriggerConfigurationCollectionResponse response = await responseTask;
            ApplyConfigurations(response);

            Snackbar.Add("Successfully fetched all triggers for this dataset.", Severity.Success);
            selectedConfiguration = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            triggerAccessor = null;
        }
        finally
        {
            loadingConfigurations = false;
        }
    }

    private void ApplyConfigurations(TriggerConfigurationCollectionResponse response)
    {
        configurations = response.Configurations;
        triggerRows = configurations
            .OrderBy(configuration => int.TryParse(configuration.Group, out int rank) ? rank : int.MaxValue)
            .Select(configuration => new TriggerListItem(configuration))
            .ToArray();
        creatingNew = false;
        selectedConfiguration = null;
    }
    private async Task Edit(TriggerConfiguration configuration)
    {
        creatingNew = false;
        selectedConfiguration = configuration;
    }

    private async Task Update()
    {
        if (!Connect()) return;
        try
        {
            var saveMethod = triggerAccessorType.GetMethods().First(m => m.Name == "SaveAsync" && m.ContainsGenericParameters).MakeGenericMethod(selectedConfiguration.GetType());

            var responseTask = (Task<TimedResponse>)this.GetType().GetMethod(nameof(Invoke))!.MakeGenericMethod(saveMethod.ReturnType.GetGenericArguments().Single()).Invoke(null, [saveMethod, triggerAccessor, new object[] { selectedConfiguration, name, CancellationToken.None }])!;

            object response = await responseTask;

            await RefreshConfigurations();
            Snackbar.Add("Successfully updated the trigger configuration.", Severity.Success);
            selectedConfiguration = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            triggerAccessor = null;
        }
    }

    private async Task CreateNewConfiguration()
    {
        creatingNew = true;
        selectedConfiguration = null;
    }

    private async Task Create()
    {
        if (!Connect()) return;
        try
        {
            var saveMethod = triggerAccessorType.GetMethods().First(m => m.Name == "SaveAsync" && m.ContainsGenericParameters).MakeGenericMethod(selectedConfiguration.GetType());

            var responseTask = (Task<TimedResponse>)this.GetType().GetMethod(nameof(Invoke))!.MakeGenericMethod(saveMethod.ReturnType.GetGenericArguments().Single()).Invoke(null, [saveMethod, triggerAccessor, new object[] { selectedConfiguration, name, CancellationToken.None }])!;

            object response = await responseTask;

            await RefreshConfigurations();
            Snackbar.Add("Successfully created the trigger configuration.", Severity.Success);
            selectedConfiguration = null;
            creatingNew = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
            triggerAccessor = null;
        }
    }

    private static readonly Type triggerAccessorType = Models.AssemblyTypes.Single(t => t.Name == "TriggerAccessor");

    public static async Task<TimedResponse> Invoke<T>(MethodInfo method, object triggerAccessor, object[] parameters) where T : TimedResponse
    {
        var taskResponse = (Task<T>)method.Invoke(triggerAccessor, parameters)!;
        return await taskResponse;
    }

    public void Dispose()
    {
        StaticDatasetStorage.AuthenticationReceived -= Authenticated;
    }
}
