@using KristofferStrube.Blazor.DOM
@using KristofferStrube.Blazor.Window
@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Relewise" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <MudLayout>
        @if (!IsEmbedded)
        {
            <MudAppBar Elevation="0" Dense="true">
                <a class="app-brand" href="" aria-label="Relewise: Blazor Apps">
                    <img src="images/relewise-logo-white.svg" alt="Relewise" />
                </a>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="app-note">Experimental Relewise tools • Maintained by Relewise</MudText>
            </MudAppBar>
        }

        @if (!IsEmbedded)
        {
            <MudDrawer Open="true" Variant="DrawerVariant.Persistent"
                       ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer" id="tool-navigation">
                <NavMenu />
            </MudDrawer>
        }

        <MudMainContent Class="@(IsEmbedded ? "embedded-content" : null)">
            @if (IsEmbedded)
            {
                <div class="embedded-note">
                    <MudText Typo="Typo.caption">Experimental Relewise tools • Maintained by Relewise</MudText>
                </div>
            }
            <article class="tool-content">
                @Body
            </article>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool IsEmbedded => StaticDatasetStorage.ParentOrigin is not null;

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    [Inject]
    public required IJSRuntime JSRuntime { get; set; }

    [SupplyParameterFromQuery]
    public string? datasetId { get; set; }

    [SupplyParameterFromQuery]
    public string? parentOrigin { get; set; }

    [Inject]
    public required IWindowService WindowService { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (datasetId is not null && parentOrigin is not null)
        {
            // Don't show menu.
            StaticDatasetStorage.ParentOrigin = parentOrigin;

            // Get dataset from querystring and remove it.
            StaticDatasetStorage.DatasetId = datasetId;
            NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("datasetId", (string?)null), false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // If the ParentMessageEventListener is already set dont set up.
        if (!firstRender || StaticDatasetStorage.ParentMessageEventListener is not null)
            return;

        // Listen for post messages.
        Window window = await WindowService.GetWindowAsync();
        StaticDatasetStorage.ParentMessageEventListener = await EventListener<MessageEvent>.CreateAsync(JSRuntime, async (e) =>
        {
            try
            {
                Authentication a = await e.GetDataAsync<Authentication>();
                if (string.IsNullOrWhiteSpace(a.apiKey))
                {
                    Console.WriteLine($"Received api key from parent window which was empty '{a.apiKey}'");
                    return;
                }
                StaticDatasetStorage.ApiKey = a.apiKey;
                StaticDatasetStorage.ServerUrl = a.serverUrl;
                StateHasChanged();
                StaticDatasetStorage.NotifyAuthenticationReceived();
            }
            catch (Exception) { }
        });

        await window.AddOnMessageEventListenerAsync(StaticDatasetStorage.ParentMessageEventListener);

        // Post message to parent.
        if (StaticDatasetStorage.ParentOrigin is not null)
        {
            // .NET's function lookup uses instanceof Function, which rejects
            // a parent window's function from another JavaScript realm.
            await using var embedding = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/embedding.js");
            await embedding.InvokeVoidAsync("notifyParentReady", StaticDatasetStorage.ParentOrigin);
        }
    }

    public record Authentication(string apiKey, string serverUrl);
}
