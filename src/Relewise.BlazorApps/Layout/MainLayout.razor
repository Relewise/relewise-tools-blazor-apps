@using KristofferStrube.Blazor.DOM
@using KristofferStrube.Blazor.Window
@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Relewise" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <MudLayout>
        @if (!IsEmbedded)
        {
            <MudAppBar Elevation="0" Dense="true">
                <RIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                             ToolTip="@(mainNavigationOpen ? "Collapse main sidebar" : "Expand main sidebar")"
                             aria-label="@(mainNavigationOpen ? "Collapse main sidebar" : "Expand main sidebar")"
                             aria-expanded="@(mainNavigationOpen ? "true" : "false")" aria-controls="tool-navigation"
                             OnClick="() => mainNavigationOpen = !mainNavigationOpen" />
                <a class="app-brand" href="" aria-label="Relewise API Explorer">
                    <span>Relewise API Explorer</span>
                </a>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="app-note">Experimental Relewise tools</MudText>
            </MudAppBar>
        }

        @if (!IsEmbedded)
        {
            <MudDrawer @bind-Open="mainNavigationOpen" Variant="DrawerVariant.Persistent"
                       ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer" id="tool-navigation">
                <NavMenu />
            </MudDrawer>
        }

        <MudMainContent Class="@(IsEmbedded ? "embedded-content" : null)">
            @if (IsEmbedded)
            {
                <div class="embedded-note">
                    <MudText Typo="Typo.caption">Experimental Relewise tools • Maintained by Relewise</MudText>
                </div>
            }
            <article class="tool-content">
                @if (!IsEmbedded && SavedConnectionStorage.Enabled && SavedConnectionStorage.HasSavedConfiguration)
                {
                    <div class="saved-configuration-action">
                        <MudTooltip Placement="Placement.Left">
                            <TooltipContent>
                                <div class="connection-tooltip">
                                    <strong>Server</strong><span>@StaticDatasetStorage.ServerUrl</span>
                                    <strong>Dataset ID</strong><span>@StaticDatasetStorage.DatasetId</span>
                                </div>
                            </TooltipContent>
                            <ChildContent>
                                <RButton Variant="Variant.Outlined" Color="Color.Error" Class="forget-configuration-button"
                                         OnClick="ForgetConfiguration">Forget saved configuration</RButton>
                            </ChildContent>
                        </MudTooltip>
                    </div>
                    <ErrorNotification Message="@SavedConnectionStorage.Error" />
                }
                @if (connectionReady)
                {
                    @Body
                }
            </article>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool mainNavigationOpen = true;
    private bool connectionRestored;
    private bool connectionReady = !SavedConnectionStorage.Enabled;
    private bool IsEmbedded => StaticDatasetStorage.ParentOrigin is not null;

    protected override void OnInitialized() => SavedConnectionStorage.Changed += ConnectionChanged;

    private void ConnectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => SavedConnectionStorage.Changed -= ConnectionChanged;

    private async Task ForgetConfiguration()
    {
        await SavedConnectionStorage.ForgetAsync(JSRuntime);
        if (SavedConnectionStorage.Error is null)
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    [Inject]
    public required IJSRuntime JSRuntime { get; set; }

    [SupplyParameterFromQuery]
    public string? datasetId { get; set; }

    [SupplyParameterFromQuery]
    public string? parentOrigin { get; set; }

    [Inject]
    public required IWindowService WindowService { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (datasetId is not null && parentOrigin is not null)
        {
            // Don't show menu.
            StaticDatasetStorage.ParentOrigin = parentOrigin;

            // Get dataset from querystring and remove it.
            StaticDatasetStorage.DatasetId = datasetId;
            NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("datasetId", (string?)null), false);
        }
        else if (SavedConnectionStorage.Enabled && !IsEmbedded && !connectionRestored)
        {
            connectionRestored = true;
            await SavedConnectionStorage.RestoreAsync(JSRuntime);
        }
        connectionReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // If the ParentMessageEventListener is already set dont set up.
        if (!firstRender || StaticDatasetStorage.ParentMessageEventListener is not null)
            return;

        // Listen for post messages.
        Window window = await WindowService.GetWindowAsync();
        StaticDatasetStorage.ParentMessageEventListener = await EventListener<MessageEvent>.CreateAsync(JSRuntime, async (e) =>
        {
            try
            {
                Authentication a = await e.GetDataAsync<Authentication>();
                if (string.IsNullOrWhiteSpace(a.apiKey))
                {
                    Console.WriteLine($"Received api key from parent window which was empty '{a.apiKey}'");
                    return;
                }
                StaticDatasetStorage.ApiKey = a.apiKey;
                StaticDatasetStorage.ServerUrl = a.serverUrl;
                StateHasChanged();
                StaticDatasetStorage.NotifyAuthenticationReceived();
            }
            catch (Exception) { }
        });

        await window.AddOnMessageEventListenerAsync(StaticDatasetStorage.ParentMessageEventListener);

        // Post message to parent.
        if (StaticDatasetStorage.ParentOrigin is not null)
        {
            // .NET's function lookup uses instanceof Function, which rejects
            // a parent window's function from another JavaScript realm.
            await using var embedding = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/embedding.js");
            await embedding.InvokeVoidAsync("notifyParentReady", StaticDatasetStorage.ParentOrigin);
        }
    }

    public record Authentication(string apiKey, string serverUrl);
}
