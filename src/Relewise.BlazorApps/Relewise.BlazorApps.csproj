<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunAOTCompilation>true</RunAOTCompilation>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="KristofferStrube.Blazor.Window" Version="0.1.0-alpha.7" />
    <PackageReference Include="KristofferStrube.DocumentSearching.SuffixTrie" Version="0.1.0-alpha.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Relewise.Client" Version="1.308.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="KristofferStrube.Blazor.Popper" Version="0.6.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="AngleSharp.Xml" Version="1.2.0" />
    <PackageReference Include="AngleSharp" Version="1.8.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Keep MessagePack on 2.x; do not upgrade to 3.x. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="KristofferStrube.Blazor.DOM" Version="0.4.0" />
    <PackageReference Include="KristofferStrube.Blazor.WebIDL" Version="0.8.0" />
  </ItemGroup>
</Project>
