@using Relewise.BlazorApps.Components
@using MudBlazor
@using global::Relewise.Client.Requests.Conditions
@using global::Relewise.Client.Requests.Filters
<span>Display Name</span>
<RIconButton Icon="@Icons.Material.Outlined.FilterAlt" Color="@(Column.Filter is null ? Color.Default : Color.Primary)"
             ToolTip="Filter by display name" aria-label="Filter by display name" aria-expanded="@(filterEditorShown ? "true" : "false")" OnClick="ShowFilter" />
@if (filterEditorShown)
{
    <div class="d-flex flex-wrap align-center ga-1">
        <RTextField Label="Name" @bind-Value="displayName" @bind-Value:after="Changed" Immediate="true" />
        <RTextField Label="Language" @bind-Value="language" @bind-Value:after="Changed" Immediate="true" />
        @if (Column.Filter is not null)
        {
            <RIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Variant="Variant.Outlined"
                         ToolTip="Remove display name filter" aria-label="Remove display name filter" OnClick="RemoveFilter" />
        }
    </div>
}

@code {
    private bool filterEditorShown = false;
    private string displayName = "";
    private string language = "";

    [Parameter, EditorRequired]
    public required Relewise.BlazorApps.Shared.Column<ProductDisplayNameFilter> Column { get; set; }

    public void ShowFilter()
    {
        filterEditorShown = !filterEditorShown;
        Column.Filter ??= new ProductDisplayNameFilter(new ContainsCondition(new DataValue("")));
    }

    public void RemoveFilter()
    {
        Column.Filter = null;
        filterEditorShown = false;
        displayName = "";
    }

    public void Changed()
    {
        try
        {
            Column.Filter = new ProductDisplayNameFilter(new ContainsCondition(new DataValue(displayName)), new Language(language));
        }
        catch
        {
            // Do nothing
        }
    }
}
