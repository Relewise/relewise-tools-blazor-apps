@using MudBlazor

<MudTooltip Delay="0">
    <TooltipContent>
        <div style="max-width:min(484px,calc(100vw - 48px));white-space:normal;overflow-wrap:anywhere;text-align:left;">@ChildContent</div>
    </TooltipContent>
    <ChildContent>
        &nbsp;<span class="round light">@(Warning ? "!" : "?")</span>
    </ChildContent>
</MudTooltip>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Warning { get; set; } = false;
}
