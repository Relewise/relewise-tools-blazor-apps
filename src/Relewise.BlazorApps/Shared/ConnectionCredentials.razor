@using MudBlazor
@using Relewise.BlazorApps.Components
@inject IJSRuntime JSRuntime

<MudStack Spacing="2" Class="mb-1">
    <MudStack Spacing="1">
        <MudText>
            First you need to insert your Dataset ID, Server URL, and API Key to connect with your dataset. You can find these at
            <MudLink Href="https://my.relewise.com/api-keys" Target="_blank">My Relewise &gt; API Keys</MudLink>.
        </MudText>
        @if (PermissionsNote is not null)
        {
            <MudText Typo="Typo.caption">@PermissionsNote</MudText>
        }
    </MudStack>

    <RGrid Spacing="2" Justify="Justify.FlexStart">
        <MudItem xs="12" sm="4">
            <RTextField Label="Dataset ID" FullWidth="true"
                        @bind-Value="StaticDatasetStorage.DatasetId" @bind-Value:after="datasetIdFilledOut"
                        Error="@(datasetIdError is not null)" ErrorText="@datasetIdError" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <RTextField Label="Server URL" FullWidth="true"
                        @bind-Value="StaticDatasetStorage.ServerUrl" @bind-Value:after="serverUrlFilledOut"
                        Error="@(serverUrlError is not null)" ErrorText="@serverUrlError" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <RTextField Label="API key" FullWidth="true" InputType="InputType.Password"
                        @bind-Value="StaticDatasetStorage.ApiKey" @bind-Value:after="apiKeyFilledOut"
                        Error="@(apiKeyError is not null)" ErrorText="@apiKeyError" />
        </MudItem>
    </RGrid>

    @if (SavedConnectionStorage.Enabled && StaticDatasetStorage.ParentOrigin is null)
    {
        <MudStack Spacing="0">
            <RCheckBox Label="Remember connection in this browser"
                       @bind-Value="SavedConnectionStorage.Remember" @bind-Value:after="RememberChanged" />
        </MudStack>
        <ErrorNotification Message="@SavedConnectionStorage.Error" />
    }
</MudStack>

@code {
    [Parameter]
    public RenderFragment? PermissionsNote { get; set; }

    string? serverUrlError;
    string? datasetIdError;
    string? apiKeyError;

    void serverUrlFilledOut()
    {
        serverUrlError = null;
        try
        {
            new Uri(StaticDatasetStorage.ServerUrl);
        }
        catch
        {
            serverUrlError = "Server URL needs to be a valid URL.";
        }
    }

    void datasetIdFilledOut()
    {
        if (Guid.TryParse(StaticDatasetStorage.DatasetId, out _))
        {
            datasetIdError = null;
        }
        else
        {
            datasetIdError = "The Dataset Id needs to be in the GUID format.";
        }
    }

    void apiKeyFilledOut()
    {
        if (string.IsNullOrWhiteSpace(StaticDatasetStorage.ApiKey))
        {
            apiKeyError = "API Key can't be empty or white spaces.";
        }
        else
        {
            apiKeyError = null;
        }
    }

    private Task RememberChanged() => SavedConnectionStorage.Remember
        ? Task.CompletedTask
        : SavedConnectionStorage.SaveAsync(JSRuntime);

}
