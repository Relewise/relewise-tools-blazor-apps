@using Relewise.BlazorApps.Components

<RNullableNumberField T="ushort" Value="Value" ValueChanged="UpdateValue"
                      AllowNull="AllowNull" ReadOnly="ReadOnly" Label="@Label" />

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter]
    public bool AllowNull { get; set; } = true;

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required ushort? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(ushort? value)
    {
        if (ReadOnly || (!AllowNull && !value.HasValue)) return;
        Value = value;
        Setter(value);
    }

    public void Set()
    {
        if (ReadOnly) return;
        Value = 0;
        Setter(Value);
    }
}