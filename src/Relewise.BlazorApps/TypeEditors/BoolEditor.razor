@using Relewise.BlazorApps.Components

<RCheckBox Label="" AriaLabel="@AriaLabel" Value="Value" ValueChanged="UpdateValue" Disabled="ReadOnly" />

@code {
    [Parameter] public string? AriaLabel { get; set; }

    private void UpdateValue(bool value)
    {
        if (ReadOnly) return;
        Value = value;
        Setter(value);
    }

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required bool Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];
}