@using System.Reflection
@using MudBlazor
@using Relewise.BlazorApps.Components
@using Humanizer
@using Relewise.BlazorApps.XmlSummaries
@using Microsoft.JSInterop
@using Newtonsoft.Json
@using Newtonsoft.Json.Converters
@using System.IO.Compression
@using global::Relewise.Client
@using KristofferStrube.Blazor.Popper
@typeparam T

<CascadingValue Value="HideDefaultValueProperties">
    @if (IsInlineValueType(typeof(T)) || (Value is not null && IsInlineValueType(Value.GetType())))
    {
        <div class="inline-value-field">
            @if (IsTopLevel)
            {
                <MudTooltip Delay="0" Inline="false" RootClass="object-label-tooltip">
                    <TooltipContent>
                        <div style="max-width:min(484px,calc(100vw - 48px));white-space:normal;overflow-wrap:anywhere;text-align:left;">
                            @(xmlDocumentation?.GetSummary(InlineValueType, "Value") ?? communityDocumentation?.GetSummary(InlineValueType, "Value"))
                        </div>
                    </TooltipContent>
                    <ChildContent>
                        <div class="object-property-label">@Settings.Name(InlineValueType)</div>
                    </ChildContent>
                </MudTooltip>
            }
            <div class="inline-value-input">
                <StringEditor Value="@InlineValue" ReadOnly="ReadOnly"
                              Setter="UpdateInlineValue" OnCopy="CopyToClipboard"
                              CopyLabel="@($"Copy {Settings.Name(InlineValueType)} as JSON")" />
            </div>
        </div>
    }
    else if (Value is null)
    {
        <div class="null-object-field @(ReadOnly ? null : "null-object-editable")"
             tabindex="@(ReadOnly ? -1 : 0)" aria-label="@($"Create {Settings.Name(typeof(T))}")"
             @onclick="DefineNullObject" @onkeydown="NullObjectKeyDown">
            <span class="null-object-placeholder">&lt;NULL&gt;</span>
            @if (!ReadOnly)
            {
                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                @if (derivedTypes.Count > 1)
                {
                    <MudMenu Label="Create" Variant="Variant.Text" Size="Size.Small" Dense="true"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown" MaxHeight="400" @bind-Open="typeMenuOpen">
                        @if (typeMenuOpen)
                        {
                            @foreach (var type in derivedTypes)
                            {
                                <MudMenuItem OnClick="() => SwitchType(type)" title="@GetTypeTitle(type)">
                                    @Settings.Name(type)
                                </MudMenuItem>
                            }
                        }
                    </MudMenu>
                }
                else
                {
                    <RButton Variant="Variant.Text" Size="Size.Small" OnClick="Create">Create</RButton>
                }
                </div>
            }
        </div>
    }
    else if (ReadOnly && Value is Statistics statistics)
    {
        <div class="statistics-inline">
            <RNullableNumberField T="double" Value="statistics.ServerTimeInMs" Label="ServerTimeInMs"
                                  AllowNull="false" ReadOnly="true" />
            <RNullableNumberField T="double" Value="statistics.NetworkTimeInMs" Label="NetworkTimeInMs"
                                  AllowNull="false" ReadOnly="true" />
        </div>
    }
    else if (FieldsOnly)
    {
        @PropertyFields
    }
    else
    {
        bool unsupportedValue = Value is not null
        && Settings.TypeInheritanceSupported.FirstOrDefault(l =>
        Value.GetType().IsAssignableTo(l.BaseType)
        && AncestorTypes.Any(a => l.AncestorInterfaces.Any(ai => a.IsAssignableTo(ai)))
        ) is { } supportedTypeLimit
        && !supportedTypeLimit.TypeInhertianceLimit.Any(l => Value.GetType().IsAssignableTo(l));

        bool ignoredValue = Value is not null
        && Settings.TypeInheritanceNotIgnored.FirstOrDefault(l =>
        Value.GetType().IsAssignableTo(l.BaseType)
        && AncestorTypes.Any(a => l.AncestorInterfaces.Any(ai => a.IsAssignableTo(ai)))
        ) is { } ignoredTypeLimit
        && !ignoredTypeLimit.TypeInhertianceLimit.Any(l => Value.GetType().IsAssignableTo(l));

        @if (IsTopLevel)
        {
            <section class="box object-top-level @((unsupportedValue || ignoredValue) ? "box-invalid" : null)">
                <header class="object-top-level-header">
                    <div class="object-header-content">
                        <h3 class="object-header-title">@Settings.Name(Value.GetType()).Humanize(LetterCasing.Title)@(ResultPresentation.Identifier(Value) is { } resultId ? $" ({resultId})" : null)</h3>
                        <div class="object-header-actions" @onclick:stopPropagation="true">
                            @HeaderActions
                            @if (!ReadOnly && CanSwitchType)
                            {
                                <MudMenu Label="Switch type" Variant="Variant.Outlined" Size="Size.Small" Dense="true"
                                         EndIcon="@Icons.Material.Filled.ArrowDropDown" MaxHeight="400" @bind-Open="typeMenuOpen">
                                    @if (typeMenuOpen)
                                    {
                                        @foreach (var type in derivedTypes)
                                        {
                                            <MudMenuItem OnClick="() => SwitchType(type)" Disabled="@(type == Value.GetType())" title="@GetTypeTitle(type)">
                                                @Settings.Name(type)
                                            </MudMenuItem>
                                        }
                                    }
                                </MudMenu>
                            }
                            <RIconButton Icon="@Icons.Material.Outlined.ContentCopy" ToolTip="Copy as JSON"
                                         aria-label="Copy object as JSON" OnClick="CopyToClipboard" />
                            @if (ShowModelShareLink)
                            {
                                <RIconButton Icon="@Icons.Material.Filled.Link" ToolTip="Copy model link"
                                             aria-label="Copy model link" OnClick="CopyLinkToClipboard" />
                            }
                        </div>
                    </div>
                    @if (unsupportedValue || ignoredValue)
                    {
                        <small class="object-header-warning">This type is @(unsupportedValue ? "not valid" : "ignored") in this context.</small>
                    }
                </header>
                @PropertyFields
            </section>
        }
        else
        {
            <details class="box @((unsupportedValue || ignoredValue) ? "box-invalid" : null)" open="@(OpenDetails || SingleLevelOpenDetails || openCreatedValue)">
                <summary class="@((unsupportedValue || ignoredValue) ? "summary-invalid" : null)" @onclick="() => hasBeenOpen = true">
                    <span class="object-type-name">
                        @ResultPresentation.Header(Value, typeof(T))
                    </span>
                    @if (Value is not null
                   && !ResultPresentation.IsResultType(Value.GetType())
                   && Properties?.FirstOrDefault(p => p.Name == "Id") is { } idProperty
                   && idProperty.GetValue(Value) is string { } idValue)
                    {
                        <text>
                            &nbsp;<u>@idValue</u>
                        </text>
                    }
                    @if (unsupportedValue)
                    {
                        <small><i>&nbsp;(the type is not valid in this context and it will make the request fail)</i></small>
                    }
                    else if (ignoredValue)
                    {
                        <small><i>&nbsp;(the type is not valid in this context so it will be ignored)</i></small>
                    }

                <div class="object-nested-actions" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    @if (CanSwitchType && !ReadOnly)
                    {
                        <MudMenu Label="Switch type" Variant="Variant.Outlined" Size="Size.Small" Dense="true"
                                 EndIcon="@Icons.Material.Filled.ArrowDropDown" MaxHeight="400" @bind-Open="typeMenuOpen">
                            @if (typeMenuOpen)
                            {
                                @foreach (var type in derivedTypes)
                                {
                                    <MudMenuItem OnClick="() => SwitchType(type)" Disabled="@(type == Value.GetType())" title="@GetTypeTitle(type)">
                                        @Settings.Name(type)
                                    </MudMenuItem>
                                }
                            }
                        </MudMenu>
                    }
                    <RIconButton Icon="@Icons.Material.Outlined.ContentCopy" ToolTip="Copy as JSON"
                                 aria-label="Copy object as JSON" OnClick="CopyToClipboard" />
                    @if (ShowModelShareLink)
                    {
                        <RIconButton Icon="@Icons.Material.Filled.Link" ToolTip="Copy model link"
                                     aria-label="Copy model link" OnClick="CopyLinkToClipboard" />
                    }
                    @if (!ReadOnly && OnRemove.HasDelegate)
                    {
                        <RIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Variant="Variant.Outlined"
                                     ToolTip="@RemoveLabel" aria-label="@RemoveLabel" OnClick="() => OnRemove.InvokeAsync()" />
                    }
                </div>
                </summary>
                @if (hasBeenOpen)
                {
                    @PropertyFields
                }
            </details>
        }
    }
</CascadingValue>


@code {
    private RenderFragment PropertyFields => @<text>
                <div class="object-properties">
                    @if (ReadOnly && Value is global::Relewise.Client.Responses.TimedResponse && !Properties.Any(ShouldShowProperty))
                    {
                        <p class="response-empty" role="status">The response contains no results or other fields to display.</p>
                    }
                    @foreach (var property in Properties)
                    {
                        PropertyInvalidContext? invalidProperty = Settings.InvalidProperties.FirstOrDefault(pic =>
                        property == pic.Property
                        && AncestorTypes.Any(a => pic.AncestorInterfaces.Any(ai => a.IsAssignableTo(ai)))
                        );

                        string propertyColor = invalidProperty is not null ? "grey" : "var(--mud-palette-text-secondary)";

                        if (ShouldShowProperty(property))
                        {
                            var potentialEditor = Settings.Editors.FirstOrDefault(editor => editor.CanHandle(property.PropertyType));
                            var editorType = potentialEditor?.EditorType(property.PropertyType);
                            string? help = property.GetCustomAttribute<ObsoleteAttribute>()?.Message
                                ?? xmlDocumentation?.GetSummary(property.DeclaringType, property.Name)
                                ?? communityDocumentation?.GetSummary(property.DeclaringType, property.Name);
                            if (invalidProperty is not null)
                                help = string.Join(" ", new[] { help, invalidProperty.Reason }.Where(text => !string.IsNullOrWhiteSpace(text)));
                            if (property.Name.Contains("Minutes") && property.PropertyType == typeof(int) && property.GetValue(Value) is int minutes)
                                help = string.Join(" ", new[] { help, TimeSpan.FromMinutes(minutes).Humanize(4) }.Where(text => !string.IsNullOrWhiteSpace(text)));
                            <div @key="property.Name" class="object-property">
                                <MudTooltip Delay="0" Inline="false" RootClass="object-label-tooltip" Disabled="@(string.IsNullOrWhiteSpace(help))">
                                    <TooltipContent>
                                        <div style="max-width:min(484px,calc(100vw - 48px));white-space:normal;overflow-wrap:anywhere;text-align:left;">@help</div>
                                    </TooltipContent>
                                    <ChildContent>
                                        <div class="object-property-label" style="color: @propertyColor">@property.Name</div>
                                    </ChildContent>
                                </MudTooltip>
                                <div class="object-value">
                                    @if (potentialEditor is not null)
                                    {
                                        var parameters = new Dictionary<string, object>()
                                        {
                                            ["ReadOnly"] = ReadOnly,
                                            ["OpenDetails"] = OpenDetails,
                                            ["Value"] = property.GetValue(Value),
                                            ["Setter"] = (object? obj) => { property.SetValue(Value, obj); Setter(Value); },
                                            ["AncestorTypes"] = (Type[])[.. AncestorTypes, Value?.GetType() ?? typeof(T)]
                                        };
                                        Settings.WithNumericNullability(parameters, property.PropertyType);
                                        if (editorType == typeof(BoolEditor) || editorType == typeof(NullableBoolEditor))
                                            parameters["AriaLabel"] = property.Name;
                                        if (!ReadOnly && !IsInlineValueType(property.PropertyType) && editorType!.IsConstructedGenericType
                                            && editorType.GetGenericTypeDefinition() == typeof(ObjectEditor<>))
                                        {
                                            parameters["OnRemove"] = EventCallback.Factory.Create(this, () => RemoveProperty(property));
                                            parameters["RemoveLabel"] = $"Remove {property.Name}";
                                        }
                                        <div class="object-editor">
                                            <ErrorBoundary>
                                                <ChildContent>
                                                    <DynamicComponent Type="editorType" Parameters="parameters" />
                                                </ChildContent>
                                                <ErrorContent>
                                                    <code>Failed to initialize editor part for @Settings.Name(property.PropertyType)</code>
                                                </ErrorContent>
                                            </ErrorBoundary>
                                        </div>
                                    }
                                    else
                                    {
                                        <code>Can't edit @Settings.Name(property.PropertyType)</code>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
    </text>;
}
