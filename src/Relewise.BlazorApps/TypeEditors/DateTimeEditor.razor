@using Relewise.BlazorApps.Components

<RDateTimeField Value="Value" ValueChanged="UpdateValue" ReadOnly="ReadOnly" AllowNull="AllowNull" />

@code {
    [Parameter] public bool AllowNull { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool OpenDetails { get; set; }
    [Parameter, EditorRequired] public required DateTime? Value { get; set; }
    [Parameter, EditorRequired] public required Action<object?> Setter { get; set; }
    [Parameter] public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(DateTime? value)
    {
        if (ReadOnly || (value is null && !AllowNull)) return;
        Value = value;
        Setter(value);
    }

    public void Create()
    {
        if (ReadOnly) return;
        Value = default(DateTime);
        Setter(Value);
    }
}
