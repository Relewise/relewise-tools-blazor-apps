@using MudBlazor
@using Relewise.BlazorApps.Components

@if (Inline)
{
    @Fields
}
else if (Value is null)
{
    <div class="data-value-null @(ReadOnly ? null : "data-value-editable")"
         tabindex="@(ReadOnly ? -1 : 0)" aria-label="Create DataValue"
         @onclick="Create" @onkeydown="CreateKeyDown">
        <span class="data-value-placeholder">&lt;NULL&gt;</span>
        @if (!ReadOnly)
        {
            <span @onclick:stopPropagation="true">
                <RButton Variant="Variant.Text" Size="Size.Small" OnClick="Create">Create</RButton>
            </span>
        }
    </div>
}
else
{
    <details class="box" open="@(OpenDetails || openCreatedValue)">
        <summary>
            <span class="data-value-title">DataValue · @Value.Type</span>
        </summary>
        @Fields
    </details>
}

@code {
    private RenderFragment Fields => @<div class="@(Inline ? "data-value-inline" : "two-column-grid")">
            @if (!Inline)
            {
                <div class="data-value-label">Type</div>
            }
            <div>
                <EnumEditor T="DataValue.DataValueTypes" Value="@(Value?.Type ?? DataValue.DataValueTypes.String)" ReadOnly=ReadOnly Setter="SetType" />
            </div>

            @if (!Inline)
            {
                <div class="data-value-label">Value</div>
            }
            <div>
                @if (Settings.Editors.FirstOrDefault(editor => editor.CanHandle(dataValueEnumTypesToTypes[Value?.Type ?? DataValue.DataValueTypes.String])) is { } editor)
                {
                    <ErrorBoundary>
                        <ChildContent>
                            <DynamicComponent Type="@editor.EditorType(dataValueEnumTypesToTypes[Value?.Type ?? DataValue.DataValueTypes.String])" Parameters="@(Settings.WithNumericNullability(new Dictionary<string, object>() { ["ReadOnly"] = ReadOnly, ["OpenDetails"] = OpenDetails,  ["Value"] = Value?.Value, ["Setter"] = (Action<object?>)SetValue, ["AncestorTypes"] = AncestorTypes }, dataValueEnumTypesToTypes[Value?.Type ?? DataValue.DataValueTypes.String]))" />
                        </ChildContent>
                        <ErrorContent>
                            <code>Failed to initialize editor part for @dataValueEnumTypesToTypes[Value?.Type ?? DataValue.DataValueTypes.String].ToString()</code>
                        </ErrorContent>
                    </ErrorBoundary>
                }
            </div>
    </div>;

    [Parameter] public bool Inline { get; set; }
    private bool openCreatedValue;

    private readonly Dictionary<DataValue.DataValueTypes, Type> dataValueEnumTypesToTypes = new()
        {
            [DataValue.DataValueTypes.String] = typeof(string),
            [DataValue.DataValueTypes.Double] = typeof(double),
            [DataValue.DataValueTypes.Boolean] = typeof(bool),
            [DataValue.DataValueTypes.Multilingual] = typeof(Multilingual),
            [DataValue.DataValueTypes.Money] = typeof(Money),
            [DataValue.DataValueTypes.MultiCurrency] = typeof(MultiCurrency),
            [DataValue.DataValueTypes.StringList] = typeof(List<string>),
            [DataValue.DataValueTypes.DoubleList] = typeof(List<double>),
            [DataValue.DataValueTypes.BooleanList] = typeof(List<bool>),
            [DataValue.DataValueTypes.MultilingualCollection] = typeof(MultilingualCollection),
            [DataValue.DataValueTypes.Object] = typeof(DataObject),
            [DataValue.DataValueTypes.ObjectList] = typeof(List<DataObject>)
        };

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required DataValue? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    public void Create()
    {
        if (ReadOnly || Value is not null) return;
        Value = Activator.CreateInstance<DataValue>();
        openCreatedValue = true;
        Setter(Value);
    }

    private void CreateKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ") Create();
    }

    private void SetValue(object? value)
    {
        if (ReadOnly) return;
        Value ??= new DataValue("");
        Value.Value = value;
        Setter(Value);
    }

    public void SetType(object? obj)
    {
        if (ReadOnly) return;
        var newEnumValue = (DataValue.DataValueTypes)obj!;
        if (newEnumValue != Value?.Type)
        {
            var newType = dataValueEnumTypesToTypes[newEnumValue];
            object? defaultValue = Settings.Editors.FirstOrDefault(editor => editor.CanHandle(newType)) is { } editor
                ? editor.InitValue(newType)
                : default;
            Value = new() { Type = newEnumValue, Value = defaultValue };
            Setter(Value);
            StateHasChanged();
        }
    }
}
