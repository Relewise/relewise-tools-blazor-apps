@typeparam T where T : struct, Enum
@using Relewise.BlazorApps.Components
@if (ReadOnly)
{
    <code>@(Value?.ToString() ?? "<NULL>")</code>
}
else
{
    <RSelect T="EnumOption" Value="SelectedOption" Items="Options" ToStringFunc="DisplayOption"
             ValueChanged="UpdateValue" Clearable="false" Style="width:100%;" />
}

@code {
    public readonly record struct EnumOption(T? Value);

    private static readonly EnumOption[] Options = Enum.GetValues<T>()
        .Select(option => new EnumOption(option)).Prepend(new EnumOption(null)).ToArray();

    private EnumOption SelectedOption => new(Value);

    private static string DisplayOption(EnumOption option) => option.Value?.ToString() ?? "<NULL>";

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required T? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(EnumOption option)
    {
        if (ReadOnly) return;
        Value = option.Value;
        Setter(Value);
    }
}
