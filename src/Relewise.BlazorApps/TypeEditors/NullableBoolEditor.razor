@using Relewise.BlazorApps.Components

<RSelect T="BooleanOption" Value="SelectedOption" Items="Options" ToStringFunc="DisplayOption"
         ValueChanged="UpdateValue" Disabled="ReadOnly" AriaLabel="@AriaLabel" Clearable="false" Style="width:100%;" />

@code {
    [Parameter] public string? AriaLabel { get; set; }

    public enum BooleanOption { Null, True, False }

    private static readonly BooleanOption[] Options = [BooleanOption.Null, BooleanOption.True, BooleanOption.False];

    private BooleanOption SelectedOption => Value switch
    {
        true => BooleanOption.True,
        false => BooleanOption.False,
        null => BooleanOption.Null
    };

    private static string DisplayOption(BooleanOption option) => option == BooleanOption.Null ? "<NULL>" : option.ToString();

    private void UpdateValue(BooleanOption option)
    {
        if (ReadOnly) return;
        bool? value = option switch
        {
            BooleanOption.True => true,
            BooleanOption.False => false,
            _ => null
        };
        Value = value;
        Setter(value);
    }

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required bool? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

}
