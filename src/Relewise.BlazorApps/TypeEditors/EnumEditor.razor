@typeparam T where T : Enum
@using Relewise.BlazorApps.Components

<RSelect T="T" Value="Value" Items="Options" ToStringFunc="DisplayOption"
         ValueChanged="UpdateValue" Disabled="ReadOnly" Required="true" Clearable="false" Style="width:100%;" />

@code {
    private static readonly T[] Options = Enum.GetValues(typeof(T)).Cast<T>()
        .Prepend((T)Enum.ToObject(typeof(T), 0)).Distinct().ToArray();

    private static string DisplayOption(T option) => option.Equals((T)Enum.ToObject(typeof(T), 0))
        && !Enum.IsDefined(typeof(T), option) ? "Select…" : option.ToString();

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required T Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(T value)
    {
        if (ReadOnly) return;
        Value = value;
        Setter(value);
    }
}
