@using Relewise.BlazorApps.Components

@if (AllowNull)
{
    <RNullableNumberField T="int" Value="Value" Label="@Label"
                      ValueChanged="value => { Value = value; Setter(value); }"
                      AllowNull="AllowNull" ReadOnly="ReadOnly" />
}
else
{
    <RNumericField Value="@(Value ?? 0)" ValueChanged="UpdateRequiredValue" Label="@Label"
                   Disabled="ReadOnly" HideSpinButtons="false" Immediate="true" FullWidth="true" />
}

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool AllowNull { get; set; } = true;

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required int? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateRequiredValue(int value)
    {
        if (ReadOnly) return;
        Value = value;
        Setter(Value);
    }
}
