@using Relewise.BlazorApps.Components

<RNullableNumberField T="float" Value="Value" ValueChanged="UpdateValue" AllowNull="false" ReadOnly="ReadOnly" />

@code {
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required float Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(float? value)
    {
        if (ReadOnly || !value.HasValue) return;
        Value = value.Value;
        Setter(Value);
    }
}