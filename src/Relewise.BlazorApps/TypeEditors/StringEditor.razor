@using Relewise.BlazorApps.Components
@using MudBlazor

<RTextField Value="@Value" ValueChanged="UpdateValue" Label="@Label" Placeholder="<NULL>"
            Clearable="@(!ReadOnly)" ReadOnly="ReadOnly" Disabled="ReadOnly"
            Adornment="@(OnCopy.HasDelegate ? Adornment.End : Adornment.None)"
            AdornmentIcon="@(OnCopy.HasDelegate ? Icons.Material.Outlined.ContentCopy : null)"
            AdornmentAriaLabel="@CopyLabel" OnAdornmentClick="() => OnCopy.InvokeAsync()"
            Immediate="true" FullWidth="true" />

@code {
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public string? CopyLabel { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required string? Value { get; set; }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    private void UpdateValue(string? value)
    {
        if (ReadOnly) return;
        Value = string.IsNullOrEmpty(value) ? null : value;
        Setter(Value);
    }
}
