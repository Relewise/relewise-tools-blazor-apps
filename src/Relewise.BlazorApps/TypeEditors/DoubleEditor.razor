@using Relewise.BlazorApps.Components

<RNullableNumberField T="double" Value="_value" ValueChanged="UpdateValue"
                      AllowNull="AllowNull" ReadOnly="ReadOnly" Label="@Label" />

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter]
    public bool AllowNull { get; set; } = true;

    private double? _value;

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public bool OpenDetails { get; set; } = false;

    [Parameter, EditorRequired]
    public required object? Value
    {
        get => _value;
        set => _value = value is not null ? Convert.ToDouble(value) : null;
    }

    [Parameter, EditorRequired]
    public required Action<object?> Setter { get; set; }

    [Parameter]
    public Type[] AncestorTypes { get; set; } = [];

    public void Set()
    {
        UpdateValue(0);
    }

    private void UpdateValue(double? value)
    {
        if (ReadOnly || (!AllowNull && !value.HasValue)) return;
        _value = value;
        Setter(value);
    }
}
